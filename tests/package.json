{
  "name": "dungeon-dash-tests",
  "private": true,
  "type": "module",
  "description": "개발용 시험 전용 폴더. 게임·교사 플랫폼 실행에는 쓰이지 않고, 배포물에도 들어가지 않는다.",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-dungeondash \"node --test test-rules/*.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.12.2"
  }
}
